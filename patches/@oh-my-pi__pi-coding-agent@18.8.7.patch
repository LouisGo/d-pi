+// Normalize parsed XML names, never rewrite user XML bytes or text values.
+// OOXML accepts arbitrary namespace prefixes; attributes use their local name.
+function localNames(value: unknown): unknown {
+	if (Array.isArray(value)) return value.map(localNames);
+	if (!value || typeof value !== "object") return value;
+	const result: Record<string, unknown> = Object.create(null);
