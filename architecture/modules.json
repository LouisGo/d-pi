{
  "version": 1,
  "root": "src/modules",
  "sourceRoots": [
    "src",
    "runtime"
  ],
  "ownedRoots": [
    "src/app",
    "src/platform",
    "src/shared"
  ],
  "unresolved": {
    "allowed": [
      "^\\.\\/gate\\.js$"
    ]
  },
  "modules": {
    "app": {
      "root": "src/app",
      "environments": [
        "contracts",
        "main",
        "host",
        "preload",
        "renderer"
      ],
      "public": [
        "contracts/desktop-bridge.ts",
        "main/index.ts",
        "host/index.ts",
        "preload/index.ts",
        "renderer/main.tsx"
      ],
      "testPublic": [
        "main/wiring/app-storage.ts"
      ],
      "dependsOn": {
        "contracts": [
          "changes",
          "conversation",
          "execution",
          "files",
          "input",
          "preferences",
          "shared",
          "threads",
          "configuration"
        ],
        "main": [
          "changes",
          "conversation",
          "execution",
          "files",
          "input",
          "platform",
          "preferences",
          "shared",
          "threads",
          "configuration"
        ],
        "host": [
          "conversation",
          "execution"
        ],
        "preload": [
          "changes",
          "conversation",
          "execution",
          "files",
          "shared",
          "configuration"
        ],
        "renderer": [
          "changes",
          "conversation",
          "execution",
          "files",
          "input",
          "preferences",
          "shared",
          "threads",
          "configuration"
        ]
      }
    },
    "platform": {
      "root": "src/platform",
      "environments": [
        "main",
        "node",
        "omp"
      ],
      "public": [
        "main/storage/public.ts",
        "main/diagnostics/public.ts",
        "node/filesystem/public.ts",
        "node/processes/public.ts",
        "omp/consumption-gate.ts",
        "omp/protocol/public.ts",
        "omp/resources/public.ts"
      ],
      "dependsOn": [
        "shared"
      ]
    },
    "shared": {
      "root": "src/shared",
      "environments": [
        "shared"
      ],
      "defaultEnvironment": "shared",
      "public": [
        "build-info.ts",
        "draft-text.ts",
        "identity.ts",
        "text/utf8.ts",
        "i18n/create-i18n.ts",
        "i18n/locale.ts",
        "messages/contracts.ts"
      ],
      "dependsOn": []
    },
    "files": {
      "root": "src/modules/files",
      "environments": [
        "contracts",
        "core",
        "main",
        "renderer"
      ],
      "public": [
        "contracts/public.ts",
        "core/public.ts",
        "main/public.ts",
        "renderer/public.ts"
      ],
      "dependsOn": {
        "contracts": [
          "shared"
        ],
        "core": [
          "shared"
        ],
        "main": [],
        "renderer": [
          "preferences",
          "threads"
        ]
      },
      "materialized": true
    },
    "input": {
      "root": "src/modules/input",
      "environments": [
        "contracts",
        "core",
        "main",
        "renderer"
      ],
      "public": [
        "contracts/public.ts",
        "core/public.ts",
        "main/public.ts",
        "renderer/public.ts"
      ],
      "dependsOn": {
        "contracts": [
          "shared",
          "threads"
        ],
        "core": [
          "files",
          "shared"
        ],
        "main": [
          "platform",
          "threads"
        ],
        "renderer": [
          "files",
          "shared"
        ]
      },
      "materialized": true
    },
    "changes": {
      "root": "src/modules/changes",
      "environments": [
        "contracts",
        "main",
        "renderer"
      ],
      "public": [
        "contracts/public.ts",
        "main/public.ts",
        "renderer/public.ts"
      ],
      "dependsOn": {
        "contracts": [
          "files",
          "shared"
        ],
        "main": [
          "files"
        ],
        "renderer": [
          "shared",
          "threads"
        ]
      },
      "materialized": true
    },
    "threads": {
      "root": "src/modules/threads",
      "environments": [
        "contracts",
        "main"
      ],
      "public": [
        "contracts/public.ts",
        "main/public.ts"
      ],
      "dependsOn": {
        "contracts": [
          "shared"
        ],
        "main": [
          "platform"
        ]
      },
      "materialized": true
    },
    "preferences": {
      "root": "src/modules/preferences",
      "environments": [
        "contracts",
        "main",
        "renderer"
      ],
      "public": [
        "contracts/public.ts",
        "main/public.ts",
        "renderer/public.ts"
      ],
      "dependsOn": {
        "contracts": [
          "shared"
        ],
        "main": [
          "platform"
        ],
        "renderer": [
          "shared"
        ]
      },
      "materialized": true
    },
    "conversation": {
      "root": "src/modules/conversation",
      "environments": [
        "contracts",
        "core",
        "host",
        "main"
      ],
      "public": [
        "contracts/public.ts",
        "core/public.ts",
        "host/public.ts",
        "main/public.ts"
      ],
      "dependsOn": {
        "contracts": [
          "shared"
        ],
        "core": [],
        "host": [
          "platform",
          "shared"
        ],
        "main": [
          "threads"
        ]
      },
      "materialized": true
    },
    "execution": {
      "root": "src/modules/execution",
      "environments": [
        "contracts",
        "core",
        "host",
        "main",
        "renderer"
      ],
      "public": [
        "contracts/public.ts",
        "core/public.ts",
        "host/public.ts",
        "main/public.ts",
        "renderer/public.ts"
      ],
      "dependsOn": {
        "contracts": [
          "input",
          "shared",
          "threads",
          "configuration"
        ],
        "core": [
          "input",
          "shared",
          "threads"
        ],
        "host": [
          "platform",
          "shared"
        ],
        "main": [
          "input",
          "platform",
          "shared",
          "threads"
        ],
        "renderer": [
          "input",
          "shared"
        ]
      },
      "materialized": true
    },
    "runtime": {
      "root": "runtime",
      "environments": [
        "omp"
      ],
      "defaultEnvironment": "omp",
      "public": [
        "host.mjs"
      ],
      "dependsOn": [],
      "materialized": true
    },
    "configuration": {
      "root": "src/modules/configuration",
      "environments": [
        "contracts",
        "main",
        "renderer"
      ],
      "public": [
        "contracts/public.ts",
        "main/public.ts",
        "renderer/public.ts"
      ],
      "dependsOn": {
        "contracts": ["shared"],
        "main": [
          "platform",
          "threads"
        ],
        "renderer": [
          "preferences"
        ]
      },
      "materialized": true
    }
  }
}
