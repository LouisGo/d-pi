{
  "name": "d-pi",
  "version": "0.1.0-s1.3",
  "private": true,
  "type": "module",
  "description": "d-pi desktop client",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:design": "oxlint -c .oxlintrc.json src/renderer",
    "test": "vitest run",
    "validate:sqlite": "electron validation/s1/sqlite.cjs && node validation/s1/crash-check.mjs",
    "validate:design": "node validation/s1/design-check.mjs",
    "validate:editor:web": "vite validation/s1/editor --config validation/s1/editor/vite.config.ts --host 127.0.0.1 --port 5178 --strictPort",
    "validate:editor": "electron validation/s1/editor/main.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:design && pnpm validate:design && node validation/s1/source-boundaries.mjs && pnpm test",
    "package:mac": "pnpm build && electron-builder --mac --dir --config.electronDist=node_modules/electron/dist"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-pattern": "5.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "oxlint": "1.85.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  },
  "author": "d-pi"
}
