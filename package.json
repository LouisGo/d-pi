{
  "name": "d-pi",
  "version": "0.1.0-s4.0",
  "private": true,
  "type": "module",
  "description": "d-pi desktop client",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit && pnpm typecheck:core && pnpm typecheck:renderer && pnpm typecheck:main && pnpm typecheck:host && pnpm typecheck:preload",
    "lint": "biome check .",
    "lint:design": "node scripts/lint-design.mjs",
    "lint:i18n": "node scripts/check-i18n-copy.mjs",
    "test": "vitest run",
    "test:architecture": "node --test tests/architecture/*.test.mjs",
    "check:architecture": "node scripts/architecture/check.mjs",
    "report:structure": "node scripts/architecture/report.mjs",
    "validate:sqlite": "electron validation/s1/sqlite.cjs && node validation/s1/crash-check.mjs",
    "validate:design": "node validation/s1/design-check.mjs",
    "validate:editor:web": "vite validation/s1/editor --config validation/s1/editor/vite.config.ts --host 127.0.0.1 --port 5178 --strictPort",
    "validate:editor": "electron validation/s1/editor/main.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:design && pnpm lint:i18n && pnpm validate:design && node validation/s1/source-boundaries.mjs && pnpm check:architecture && pnpm test:architecture && pnpm test",
    "package:mac": "pnpm runtime:sdk && pnpm build && electron-builder --mac --dir --config.electronDist=node_modules/electron/dist",
    "runtime:fetch": "node scripts/fetch-runtime.mjs",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "typecheck:main": "tsc --noEmit -p tsconfig.main.json",
    "typecheck:host": "tsc --noEmit -p tsconfig.host.json",
    "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json",
    "runtime:sdk": "node scripts/prepare-sdk.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@formatjs/intl": "6.1.2",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@streamdown/code": "1.1.1",
    "@tanstack/react-query": "5.104.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "streamdown": "2.6.0",
    "ts-pattern": "5.9.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@formatjs/icu-messageformat-parser": "3.5.20",
    "@oh-my-pi/pi-coding-agent": "18.3.0",
    "@oh-my-pi/pi-utils": "18.3.0",
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "bun": "1.3.14",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "oxlint": "1.85.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  },
  "author": "d-pi",
  "pnpm": {
    "onlyBuiltDependencies": [
      "bun"
    ]
  }
}
