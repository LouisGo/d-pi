+import { Editor, getSchema } from "@tiptap/core";
+import { EditorState } from "@tiptap/pm/state";
+import { expect, it } from "vitest";
+import { captureSelection } from "../../src/modules/files/core/public";
+import { parseDraftBlocks } from "../../src/modules/input/core/public";
+import {
+  appendSelectionReference,
+  draftDocument,
+  plainTextEditorOptions,
+  replaceDraftText,
+} from "../../src/modules/input/renderer/public";
+
+it("keeps both Diff sides and exact frozen bytes through insertion and draft restoration", () => {
+  const path = "src/@message@List.ts";
+  const range = {
+    startLineNumber: 1,
+    startColumn: 3,
+    endLineNumber: 4,
+    endColumn: 3,
+  };
+  const left = captureSelection(
+    "  😀\r\n\tleft\r[/d-pi:file-selection]\n尾部",
+    range,
+    { path, source: "HEAD: src/@message@List.ts", version: "git:before" },
+  );
+  const workingTree = {
+    text: "  😀\n\tright\r\n[/d-pi:file-selection]\r最新",
+    source: { path, source: "working tree", version: "sha256:after" },
+  };
+  const right = captureSelection(workingTree.text, range, workingTree.source);
+  if (left.kind !== "selection" || right.kind !== "selection")
+    throw Error("Fixture selections failed");
+  expect(left.text).toBe("😀\r\n\tleft\r[/d-pi:file-selection]\n尾部");
+  expect(right.text).toBe("😀\n\tright\r\n[/d-pi:file-selection]\r最新");
+
+  const schema = getSchema(plainTextEditorOptions.extensions);
+  let state = EditorState.create({
+    schema,
+    doc: schema.nodeFromJSON(draftDocument("existing draft")),
+  });
+  for (const selection of [left, right])
+    state = state.apply(appendSelectionReference(state, selection));
+
+  // Updating the source pane's sample must not rewrite an attached quote.
+  workingTree.text = "new disk content";
+  workingTree.source.version = "sha256:new-disk";
+  const editor = new Editor({
+    ...plainTextEditorOptions,
+    element: null,
+    content: state.doc.toJSON(),
+  });
+  try {
+    const persisted = editor.getText({ blockSeparator: "\n" });
+    expect(parseDraftBlocks(persisted)).toEqual([
+      { kind: "paragraph", text: "existing draft" },
+      { kind: "selection", value: left },
+      { kind: "selection", value: right },
+    ]);
+    expect(replaceDraftText(editor, persisted)).toBe(true);
+    expect(editor.state.doc.child(1).attrs).toEqual(left);
+    expect(editor.state.doc.child(2).attrs).toEqual(right);
+    expect(editor.state.doc.child(2).attrs).toMatchObject({
+      text: "😀\n\tright\r\n[/d-pi:file-selection]\r最新",
+      version: "sha256:after",
+    });
+    expect(editor.getText({ blockSeparator: "\n" })).toBe(persisted);
+  } finally {
+    editor.destroy();
+  }
+});
+
+it("cannot rewrite files' captured source or text while the reference waits for insertion", () => {
+  const value = captureSelection(
+    "first\r\n  原文😀",
+    { startLineNumber: 1, startColumn: 1, endLineNumber: 2, endColumn: 7 },
+    { path: "src/a.ts", source: "index", version: "git:original" },
+  );
+  if (value.kind !== "selection") throw Error("Fixture selection failed");
+  const captured = { ...value };
+  // All consumers share this handoff value while IME can defer insertion.
+  // It must not become a mutable route to changing an already captured quote.
+  Reflect.set(value, "path", "src/b.ts");
+  Reflect.set(value, "source", "working tree");
+  Reflect.set(value, "version", "sha256:new");
+  Reflect.set(value, "text", "replacement");
+  Reflect.set(value, "startLine", 99);
+
+  const schema = getSchema(plainTextEditorOptions.extensions);
+  const state = EditorState.create({
+    schema,
+    doc: schema.nodeFromJSON(draftDocument("")),
+  });
+  const next = state.apply(appendSelectionReference(state, value));
+  expect(next.doc.lastChild?.attrs).toEqual(captured);
+});
