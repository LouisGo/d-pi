diff --git a/src/modules/files/contracts/selection.ts b/src/modules/files/contracts/selection.ts
new file mode 100644
index 0000000..906d38e
--- /dev/null
+++ b/src/modules/files/contracts/selection.ts
@@ -0,0 +1,24 @@
+import { z } from "zod";
+import { utf8ByteLength } from "../../../shared/text/utf8";
+
+export const MAX_SELECTION_BYTES = 64 * 1024;
+
+/** Files delivers the selected side's original text and provenance together.
+ * Input persists this value; it never re-reads the path to rebuild a quote. */
+export const FrozenFileSelectionSchema = z
+  .strictObject({
+    kind: z.literal("selection"),
+    path: z.string().max(4096),
+    source: z.string().max(8192),
+    version: z.string().max(256),
+    text: z
+      .string()
+      .min(1)
+      .refine((text) => utf8ByteLength(text) <= MAX_SELECTION_BYTES),
+    startLine: z.number().int().positive(),
+    startColumn: z.number().int().positive(),
+    endLine: z.number().int().positive(),
+    endColumn: z.number().int().positive(),
+  })
+  .readonly();
+export type FrozenFileSelection = z.infer<typeof FrozenFileSelectionSchema>;
