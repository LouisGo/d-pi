@@ -0,0 +1,53 @@
+import type { EditorState, Transaction } from "@tiptap/pm/state";
+import { useEffect, useRef } from "react";
+import type { FrozenFileSelection } from "../../files/contracts/public";
+import { appendSelectionReference } from "./selection-insert";
+
+/** The app routes an attachment to a Thread; input owns applying it once. */
+export interface SelectionAttachment {
+  readonly id: string;
+  readonly threadId: string;
+  readonly selection: FrozenFileSelection;
+}
+type SelectionEditor = {
+  readonly state: EditorState;
+  readonly isDestroyed: boolean;
+  readonly view: {
+    readonly composing: boolean;
+    readonly dom: Pick<EventTarget, "addEventListener" | "removeEventListener">;
+    dispatch(transaction: Transaction): void;
+  };
+  readonly commands: { focus(position: "end"): boolean };
+};
+
+export function useSelectionAttachment(
+  editor: SelectionEditor | null,
+  attachment: SelectionAttachment | null | undefined,
+  threadId: string,
+  isCurrent: () => boolean,
+  onApplied: ((id: string) => void) | undefined,
+): void {
+  const lastAttachment = useRef<string | null>(null);
+  useEffect(() => {
+    if (
+      !editor ||
+      !attachment ||
+      attachment.threadId !== threadId ||
+      lastAttachment.current === attachment.id
+    )
+      return;
+    const apply = () => {
+      if (!isCurrent() || editor.isDestroyed || editor.view.composing) return;
+      editor.view.dispatch(
+        appendSelectionReference(editor.state, attachment.selection),
+      );
+      lastAttachment.current = attachment.id;
+      editor.commands.focus("end");
+      onApplied?.(attachment.id);
+    };
+    if (editor.view.composing)
+      editor.view.dom.addEventListener("compositionend", apply, { once: true });
+    else apply();
+    return () => editor.view.dom.removeEventListener("compositionend", apply);
+  }, [editor, attachment, threadId, isCurrent, onApplied]);
+}
