+import { beforeEach, expect, it, vi } from "vitest";
+import { captureSelection } from "../../files/core/public";
+import { draftDocument, plainTextEditorOptions } from "./plain-text-editor";
+import {
+  type SelectionAttachment,
+  useSelectionAttachment,
+} from "./selection-attachment";
+
+type Effect = () => undefined | (() => void);
+const harness = vi.hoisted(() => ({
+  refIndex: 0,
+  refs: new Array<{ current: unknown }>(),
+  effects: new Array<Effect>(),
+}));
+vi.mock("react", () => ({
+  useRef(initial: unknown) {
+    const index = harness.refIndex++;
+    harness.refs[index] ??= { current: initial };
+    return harness.refs[index];
+  },
+  useEffect(effect: Effect) {
+    harness.effects.push(effect);
+  },
+}));
+beforeEach(() => {
+  harness.refIndex = 0;
+  harness.refs.length = 0;
+  harness.effects.length = 0;
+});
+
+function fixture() {
+  const selection = captureSelection(
+    "a\r\n原文😀",
+    { startLineNumber: 1, startColumn: 1, endLineNumber: 2, endColumn: 5 },
+    { path: "src/a.ts", source: "index", version: "git:original" },
+  );
+  if (selection.kind !== "selection") throw Error("Fixture selection failed");
+  const attachment: SelectionAttachment = {
+    id: crypto.randomUUID(),
+    threadId: crypto.randomUUID(),
+    selection,
+  };
+  const schema = getSchema(plainTextEditorOptions.extensions);
+  let state = EditorState.create({
+    schema,
+    doc: schema.nodeFromJSON(draftDocument("draft")),
+  });
+  const view = {
+    composing: false,
+    dom: new EventTarget(),
+    dispatch(transaction: Transaction) {
+      state = state.apply(transaction);
+    },
+  };
+  const editor = {
+    get state() {
+      return state;
+    },
+    isDestroyed: false,
+    view,
+    commands: { focus: vi.fn(() => true) },
+  };
+  const applied = vi.fn();
+  let current = true;
+  const isCurrent = () => current;
+  const render = (value = attachment, threadId = attachment.threadId) => {
+    harness.refIndex = 0;
+    harness.effects.length = 0;
+    useSelectionAttachment(editor, value, threadId, isCurrent, applied);
+    const cleanups = harness.effects.map((effect) => effect());
+    return () => {
+      for (const cleanup of cleanups) cleanup?.();
+    };
+  };
+  return {
+    attachment,
+    editor,
+    applied,
+    render,
+    leaveThread() {
+      current = false;
+    },
+  };
+}
+
+// React effects and the native composition event are narrow boundary doubles.
+// Document insertion uses the real Tiptap schema and ProseMirror transaction.
+it("applies each attachment once, allowing an explicit second quote of the same selection", () => {
+  const value = fixture();
+  const cleanup = value.render();
+  expect(value.editor.state.doc.lastChild?.attrs).toEqual(
+    value.attachment.selection,
+  );
+  expect(value.editor.commands.focus).toHaveBeenCalledWith("end");
+  expect(value.applied).toHaveBeenCalledExactlyOnceWith(value.attachment.id);
+  cleanup();
+  value.render();
+  expect(value.editor.state.doc.childCount).toBe(2);
+  const second = { ...value.attachment, id: crypto.randomUUID() };
+  value.render(second);
+  expect(value.editor.state.doc.childCount).toBe(3);
+  expect(value.applied).toHaveBeenLastCalledWith(second.id);
+});
+
+it("waits for composition to finish before inserting the frozen selection", () => {
+  const value = fixture();
+  value.editor.view.composing = true;
+  const cleanup = value.render();
+  expect(value.editor.state.doc.childCount).toBe(1);
+  expect(value.applied).not.toHaveBeenCalled();
+  value.editor.view.composing = false;
+  value.editor.view.dom.dispatchEvent(new Event("compositionend"));
+  expect(value.editor.state.doc.lastChild?.attrs).toEqual(
+    value.attachment.selection,
+  );
+  expect(value.applied).toHaveBeenCalledExactlyOnceWith(value.attachment.id);
+  cleanup();
+});
+
+it("ignores a mismatched Thread and rechecks a deferred attachment after a Thread switch", () => {
+  const value = fixture();
+  value.render(value.attachment, crypto.randomUUID());
+  expect(value.editor.state.doc.childCount).toBe(1);
+  value.editor.view.composing = true;
+  const cleanup = value.render();
+  value.leaveThread();
+  value.editor.view.composing = false;
+  value.editor.view.dom.dispatchEvent(new Event("compositionend"));
+  expect(value.editor.state.doc.childCount).toBe(1);
+  expect(value.applied).not.toHaveBeenCalled();
+  cleanup();
+});
+
+it("releases the deferred listener on cleanup and ignores a destroyed editor", () => {
+  const value = fixture();
+  value.editor.view.composing = true;
+  const cleanup = value.render();
+  cleanup();
+  value.editor.view.composing = false;
+  value.editor.view.dom.dispatchEvent(new Event("compositionend"));
+  expect(value.editor.state.doc.childCount).toBe(1);
+  value.editor.isDestroyed = true;
+  value.render();
+  expect(value.editor.state.doc.childCount).toBe(1);
+  expect(value.applied).not.toHaveBeenCalled();
+});
