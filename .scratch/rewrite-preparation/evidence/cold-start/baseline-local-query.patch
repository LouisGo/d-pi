+
+it("does not expose an empty-path cache entry or read when no file is selected", async () => {
+  const client_ = client();
+  const requests: FileRequest[] = [];
+  const bridge: FileBridge = {
+    request: (request) => {
+      requests.push(request);
+      return Promise.resolve(text(request.path, "unexpected"));
+    },
+  };
+  client_.setQueryData(fileKeys.content(threadId, ""), text("", "cached root"));
+  const options = fileQueryOptions.content(bridge, threadId, undefined);
+  const observer = new QueryObserver(client_, options);
+  const release = observer.subscribe(() => {});
+  try {
+    expect(observer.getCurrentResult().data).toBeUndefined();
+    expect(observer.getCurrentResult().isEnabled).toBe(false);
+    await client_.invalidateQueries({ queryKey: fileKeys.all(threadId) });
+    expect(requests).toEqual([]);
+    const result = await observer.refetch();
+    expect(result.data).toBeNull();
+    expect(requests).toEqual([]);
+    expect(client_.getQueryData(fileKeys.content(threadId, ""))).toMatchObject({
+      text: "cached root",
+    });
+  } finally {
+    release();
+    client_.clear();
+  }
+});
+
+it("returns an empty result without IPC for an imperative unselected content query", async () => {
+  const client_ = client();
+  const requests: FileRequest[] = [];
+  const bridge: FileBridge = {
+    request: (request) => {
+      requests.push(request);
+      return Promise.resolve(text(request.path, "unexpected"));
+    },
+  };
+  try {
+    const result = await client_.fetchQuery(
+      fileQueryOptions.content(bridge, threadId, undefined),
+    );
+    expect(result).toBeNull();
+    expect(requests).toEqual([]);
+  } finally {
+    client_.clear();
+  }
+});
+
+it("shares a selected local content sample between imperative and observed reads while offline", async () => {
+  const client_ = client();
+  const requests: FileRequest[] = [];
+  const reply = text("selected.ts", "local content");
+  const bridge: FileBridge = {
+    request: (request) => {
+      requests.push(request);
+      return Promise.resolve(reply);
+    },
+  };
+  const wasOnline = onlineManager.isOnline();
+  onlineManager.setOnline(false);
+  try {
+    const options = {
+      ...fileQueryOptions.content(bridge, threadId, "selected.ts"),
+      staleTime: Number.POSITIVE_INFINITY,
+    };
+    const result = await client_.fetchQuery(options);
+    const observer = new QueryObserver(client_, options);
+    const release = observer.subscribe(() => {});
+    try {
+      expect(result).toBe(reply);
+      expect(observer.getCurrentResult().data).toBe(result);
+      expect(observer.getCurrentResult().isEnabled).toBe(true);
+      expect(requests).toHaveLength(1);
+      expect(requests[0]).toMatchObject({
+        kind: "read",
+        threadId,
+        path: "selected.ts",
+        traceId: expect.stringMatching(/^[0-9a-f-]{36}$/),
+      });
+    } finally {
+      release();
+    }
+  } finally {
+    onlineManager.setOnline(wasOnline);
+    client_.clear();
+  }
+});
+
+it("clears the observed content when selection is removed and ignores its late reply", async () => {
+  const client_ = client();
+  let finish: (reply: FileReply) => void = () => {};
+  const requests: FileRequest[] = [];
+  const bridge: FileBridge = {
+    request: (request) => {
+      requests.push(request);
+      return new Promise<FileReply>((accept) => {
+        finish = accept;
+      });
+    },
+  };
+  const observer = new QueryObserver(
+    client_,
+    fileQueryOptions.content(bridge, threadId, "previous.ts"),
+  );
+  const release = observer.subscribe(() => {});
+  try {
+    const pending = observer.refetch();
+    observer.setOptions(fileQueryOptions.content(bridge, threadId, undefined));
+    expect(observer.getCurrentResult().data).toBeUndefined();
+    expect(observer.getCurrentResult().isEnabled).toBe(false);
+    finish(text("previous.ts", "late content"));
+    await pending;
+    expect(observer.getCurrentResult().data).toBeUndefined();
+    expect(
+      client_.getQueryData(fileKeys.content(threadId, "previous.ts")),
+    ).toMatchObject({
+      text: "late content",
+    });
+    expect(requests.map(({ path }) => path)).toEqual(["previous.ts"]);
+  } finally {
+    release();
+    client_.clear();
+  }
+});
