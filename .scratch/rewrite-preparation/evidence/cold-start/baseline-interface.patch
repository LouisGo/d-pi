@@ -0,0 +1,106 @@
+import { expect, test } from "vitest";
+import { diffCodeView, fileCodeView } from "./code-view";
+import { captureCodeViewSelection } from "./selection";
+
+test("file view hands off the original text and capture source before later file changes", () => {
+  const reply = {
+    kind: "text" as const,
+    path: "src/a;\n.ts",
+    text: "pre😀\r\n  第二行\rtail\nlast",
+    version: "sha256:original",
+    capturedAt: "2026-09-30T00:00:00Z",
+    bytes: 32,
+    coverage: "complete" as const,
+  };
+  const view = fileCodeView(reply, "working tree");
+  const selection = captureCodeViewSelection(view, "file", {
+    startLineNumber: 1,
+    startColumn: 4,
+    endLineNumber: 3,
+    endColumn: 3,
+  });
+  reply.path = "src/renamed.ts";
+  reply.text = "changed";
+  reply.version = "sha256:changed";
+  reply.capturedAt = "2026-09-30T00:01:00Z";
+  expect(selection).toEqual({
+    kind: "selection",
+    path: "src/a;\n.ts",
+    source: "working tree · 2026-09-30T00:00:00Z",
+    version: "sha256:original",
+    text: "😀\r\n  第二行\rta",
+    startLine: 1,
+    startColumn: 4,
+    endLine: 3,
+    endColumn: 3,
+  });
+});
+
+test("diff selections retain the chosen side's path, source, version and original text", () => {
+  const view = diffCodeView({
+    path: "src/current.ts",
+    previousPath: "src/previous.ts",
+    left: {
+      kind: "text",
+      text: "old😀\r\nleft",
+      source: "HEAD: src/previous.ts",
+      version: "blob:old",
+    },
+    right: {
+      kind: "text",
+      text: "new😀\nright",
+      source: "index: src/current.ts",
+      version: "blob:new",
+    },
+  });
+  const range = {
+    startLineNumber: 1,
+    startColumn: 4,
+    endLineNumber: 2,
+    endColumn: 3,
+  };
+  expect(captureCodeViewSelection(view, "left", range)).toEqual({
+    kind: "selection",
+    path: "src/previous.ts",
+    source: "HEAD: src/previous.ts",
+    version: "blob:old",
+    text: "😀\r\nle",
+    startLine: 1,
+    startColumn: 4,
+    endLine: 2,
+    endColumn: 3,
+  });
+  expect(captureCodeViewSelection(view, "right", range)).toEqual({
+    kind: "selection",
+    path: "src/current.ts",
+    source: "index: src/current.ts",
+    version: "blob:new",
+    text: "😀\nri",
+    startLine: 1,
+    startColumn: 4,
+    endLine: 2,
+    endColumn: 3,
+  });
+});
+
+test("an absent diff side and a mismatched pane never create a file reference", () => {
+  const view = diffCodeView({
+    path: "new.ts",
+    left: { kind: "absent", source: "HEAD: absent" },
+    right: { kind: "text", text: "new", source: "index", version: "blob:new" },
+  });
+  const range = {
+    startLineNumber: 1,
+    startColumn: 1,
+    endLineNumber: 1,
+    endColumn: 1,
+  };
+  expect(captureCodeViewSelection(view, "left", range)).toEqual({
+    kind: "invalid",
+    reason: "empty",
+  });
+  expect(captureCodeViewSelection(view, "file", range)).toEqual({
+    kind: "invalid",
+    reason: "range",
+  });
+});
