@@ -0,0 +1,90 @@
+import { match } from "ts-pattern";
+import type { FileReply } from "../contracts/public";
+
+export interface SelectionSource {
+  readonly path: string;
+  readonly source: string;
+  readonly version: string;
+}
+
+export interface CodePane {
+  readonly text: string;
+  readonly source: SelectionSource;
+}
+export type CodeViewModel =
+  | ({ readonly kind: "file" } & CodePane)
+  | {
+      readonly kind: "diff";
+      readonly left: CodePane;
+      readonly right: CodePane;
+    };
+
+/** Presentation input: files does not read Git or choose the diff baseline. */
+type CodeContent =
+  | {
+      readonly kind: "text";
+      readonly text: string;
+      readonly source: string;
+      readonly version: string;
+    }
+  | { readonly kind: "absent"; readonly source: string };
+export interface DiffCodeSource {
+  readonly path: string;
+  readonly previousPath?: string | undefined;
+  readonly left: CodeContent;
+  readonly right: CodeContent;
+}
+
+export function fileCodeView(
+  file: Extract<FileReply, { kind: "text" }>,
+  sourceLabel: string,
+): CodeViewModel {
+  return {
+    kind: "file",
+    text: file.text,
+    source: {
+      path: file.path,
+      source: `${sourceLabel} · ${file.capturedAt}`,
+      version: file.version,
+    },
+  };
+}
+
+export function diffCodeView(diff: DiffCodeSource): CodeViewModel {
+  const pane = (path: string, content: CodeContent): CodePane =>
+    match(content)
+      .with({ kind: "text" }, ({ text, source, version }) => ({
+        text,
+        source: { path, source, version },
+      }))
+      .with({ kind: "absent" }, ({ source }) => ({
+        text: "",
+        source: { path, source, version: "absent" },
+      }))
+      .exhaustive();
+  return {
+    kind: "diff",
+    left: pane(diff.previousPath ?? diff.path, diff.left),
+    right: pane(diff.path, diff.right),
+  };
+}
+
+/** Stable editor identity: locale display strings must not recreate Monaco. */
+export function codeViewIdentity(view: CodeViewModel): string {
+  if (view.kind === "file")
+    return `file|${view.source.path}|${view.source.version}|${view.text.length}`;
+  return (
+    `diff|${view.left.source.path}|${view.left.source.version}|${view.left.text.length}` +
+    `|${view.right.source.path}|${view.right.source.version}|${view.right.text.length}`
+  );
+}
+
+/** Full reads allow 5 MiB; defer costly visual comparison above this per-pane budget. */
+export const MAX_DIFF_PANE_CHARS = 512 * 1024;
+export function isDiffViewTooLarge(view: CodeViewModel): boolean {
+  return (
+    view.kind === "diff" &&
+    (view.left.text.length > MAX_DIFF_PANE_CHARS ||
+      view.right.text.length > MAX_DIFF_PANE_CHARS)
+  );
+}
