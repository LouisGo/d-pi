+export function captureCodeViewSelection(
+  view: CodeViewModel,
+  side: "file" | "left" | "right",
+  range: TextRange,
+): FrozenSelection {
+  const pane = match(view)
+    .with({ kind: "file" }, (file) => (side === "file" ? file : null))
+    .with({ kind: "diff" }, (diff) => (side === "file" ? null : diff[side]))
