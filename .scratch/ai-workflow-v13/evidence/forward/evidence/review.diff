@@ -0,0 +1,21 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { normalizeId } from "../src/normalize.mjs";
+
+test("trims identifiers while preserving letter suffixes and content", () => {
+  assert.equal(normalizeId(" \t02a\n"), "02a");
+  assert.equal(normalizeId("task-04b"), "task-04b");
+  assert.equal(normalizeId("任务 07c"), "任务 07c");
+});
+
+test("rejects empty and whitespace-only identifiers", () => {
+  for (const value of ["", " \t\n", "\u00a0"]) {
+    assert.throws(() => normalizeId(value), TypeError);
+  }
+});
+
+test("rejects non-string identifiers without coercion", () => {
+  for (const value of [undefined, null, 2, true, [], {}, new String("02a")]) {
+    assert.throws(() => normalizeId(value), TypeError);
+  }
+});
