+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { stateLabel } from "../src/labels.mjs";
+
+test("labels all supported task states", () => {
+  assert.equal(stateLabel("open"), "待执行");
+  assert.equal(stateLabel("claimed"), "处理中");
+  assert.equal(stateLabel("resolved"), "已完成");
+});
+
+test("rejects unknown states without property lookup or coercion", () => {
+  for (const status of ["unknown", "OPEN", " open ", "", "toString", "__proto__", undefined, null, {}, ["open"]]) {
+    assert.throws(() => stateLabel(status), TypeError);
+  }
+});
