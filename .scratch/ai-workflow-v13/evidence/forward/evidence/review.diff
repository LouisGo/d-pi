new file mode 100644
index 0000000..07872fd
--- /dev/null
+++ b/src/normalize.mjs
@@ -0,0 +1,6 @@
+export function normalizeId(value) {
+  if (typeof value !== "string" || value.trim().length === 0) {
+    throw new TypeError("Identifier must be a nonempty string");
+  }
+  return value.trim();
+}
