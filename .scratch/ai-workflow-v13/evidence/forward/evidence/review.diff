+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { describeTicket, echoId } from "../src/index.mjs";
+
+test("describes a trimmed identifier and its exact state label", () => {
+  assert.equal(describeTicket({ id: " \t02a\n", status: "open" }), "02a: 待执行");
+  assert.equal(describeTicket({ id: "03", status: "claimed" }), "03: 处理中");
+  assert.equal(describeTicket({ id: " 04b ", status: "resolved" }), "04b: 已完成");
+});
+
+test("composition preserves identifier and state validation", () => {
+  assert.throws(() => describeTicket({ id: " \t", status: "open" }), TypeError);
+  assert.throws(() => describeTicket({ id: 4, status: "open" }), TypeError);
+  assert.throws(() => describeTicket({ id: "04", status: "unknown" }), TypeError);
+});
+
+test("adding descriptions keeps echoId identity behavior", () => {
+  assert.equal(echoId(" 02a "), " 02a ");
+});
